# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# NOTE: BASE_URL and API_BASE_URL are NOT set here anymore — they live in
# the committed .env.dev / .env.qa / .env.uat files (env-specific, non-secret).
# This file is only for secrets and the environment selector.

# Which .env.<ENV> file to load (dev/qa/uat). Defaults to "dev" if unset.
ENV=dev

TEST_USER_EMAIL=
TEST_USER_PASSWORD=
